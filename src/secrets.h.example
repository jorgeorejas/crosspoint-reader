#pragma once

// ============================================================================
// Calendar API Configuration
// ============================================================================
// This file contains the API endpoint configuration for the calendar feature.
//
// The CrossPoint web server uses this external API to fetch and parse calendar
// events from iCal feeds. The device calls the local web server, which then
// proxies requests to this external API.
//
// USAGE:
// ------
// 1. Copy this file to `secrets.h` in the same directory (if customizing)
// 2. The default configuration uses https://www.jorgeorejas.com/calendar
// 3. The actual `secrets.h` file is gitignored and will not be committed
//
// API SPECIFICATION:
// ------------------
// Full spec available at: https://www.jorgeorejas.com/calendar/spec.json
//
// Endpoints:
// - GET /calendar.json
//   Returns events from the default calendar
//
// - GET /calendar/custom.json?url=<ics-url>&past=<days>&future=<days>
//   Returns events from any iCal URL with configurable date window
//
// Query Parameters:
// - url (string, required for custom): Full URL to an iCal (.ics) feed
// - past (integer, 0-30, default: 2): Historical days to include
// - future (integer, 0-30, default: 2): Upcoming days to include
//
// Security:
// - Only HTTP/HTTPS protocols allowed
// - Private IPs and localhost blocked (SSRF protection)
// - Cloud metadata endpoints blocked (169.254.x.x)
//
// Response Format:
// {
//   "past": [
//     {
//       "date": "2024-01-15",
//       "events": [
//         {
//           "id": "event-123",
//           "title": "Meeting",
//           "start": "2024-01-15T09:00:00Z",
//           "end": "2024-01-15T10:00:00Z",
//           "location": "Office",
//           "description": "Team sync",
//           "url": "https://example.com/event/123",
//           "isAllDay": false
//         }
//       ]
//     }
//   ],
//   "today": {
//     "date": "2024-01-16",
//     "events": [...]
//   },
//   "future": [...]
// }
// ============================================================================

// Calendar API base URL - default uses jorgeorejas.com spec-compliant API
#define CALENDAR_API_BASE_URL "https://www.jorgeorejas.com"

// Calendar API endpoint paths (do not change unless using custom API)
#define CALENDAR_API_DEFAULT_PATH "/calendar.json"
#define CALENDAR_API_CUSTOM_PATH "/calendar/custom.json"
