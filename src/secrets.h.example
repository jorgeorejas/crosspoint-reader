#pragma once

// ============================================================================
// Calendar API Configuration
// ============================================================================
// This file contains private API endpoint configuration for the calendar feature.
//
// IMPORTANT: This is a template file. To use it:
// 1. Copy this file to `secrets.h` in the same directory
// 2. Replace the placeholder URL with your actual API endpoint
// 3. The actual `secrets.h` file is gitignored and will not be committed
//
// The calendar API should conform to the schema documented at:
// https://www.jorgeorejas.com/calendar/spec.json
//
// API Endpoints:
// --------------
// - /calendar.json - Returns events from a default calendar
// - /calendar/custom.json?url=<ics-url> - Returns events from any iCal URL
//
// Query Parameters:
// -----------------
// - past (integer, 0-30, default: 2): Days before today to include
// - future (integer, 0-30, default: 2): Days after today to include
// - url (string, custom endpoint only): Full URL to an iCal (.ics) feed
//
// Response Format:
// ----------------
// {
//   "past": [
//     {
//       "date": "2024-01-15",
//       "events": [
//         {
//           "id": "event-123",
//           "title": "Meeting",
//           "start": "2024-01-15T09:00:00Z",
//           "end": "2024-01-15T10:00:00Z",
//           "location": "Office",
//           "description": "Team sync",
//           "url": "https://example.com/event/123",
//           "isAllDay": false
//         }
//       ]
//     }
//   ],
//   "today": {
//     "date": "2024-01-16",
//     "events": [...]
//   },
//   "future": [...]
// }
// ============================================================================

// Replace this URL with your actual calendar API base URL
#define CALENDAR_API_BASE_URL "https://example.com"

// Calendar API endpoint paths
#define CALENDAR_API_DEFAULT_PATH "/calendar.json"
#define CALENDAR_API_CUSTOM_PATH "/calendar/custom.json"
